# ── Supabase : nouveau format standard (variables serveur, obligatoire en prod) ──
SUPABASE_URL=https://ztoetlxicdkglvwjdxqt.supabase.co
SUPABASE_PUBLISHABLE_KEY=<sb_publishable_...>
# Usage SERVEUR uniquement (push notifications, admin) — ne JAMAIS exposer au client
SUPABASE_SECRET_KEY=<sb_secret_...>
SUPABASE_JWKS_URL=https://ztoetlxicdkglvwjdxqt.supabase.co/auth/v1/.well-known/jwks.json

# ── Supabase : format historique (compatibilité conservée dans le code) ──
NEXT_PUBLIC_SUPABASE_URL=https://ztoetlxicdkglvwjdxqt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<clé anon / publishable exposable au navigateur>
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<sb_publishable_... si fournie au client>

# ── Push notifications (Web Push / VAPID) ──
NEXT_PUBLIC_VAPID_PUBLIC_KEY=<clé publique VAPID>
VAPID_PRIVATE_KEY=<clé privée VAPID>
VAPID_SUBJECT=mailto:contact@biso-invest.com